# ─────────────────────────────────────────────────────────────────────────────
#  GROUPON POWER – Environment Configuration
#  Copy this to .env and fill in your real values before deploying.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask Core ────────────────────────────────────────────────────────────────
FLASK_APP=run.py
FLASK_ENV=production
PORT=5000

# Generate strong secrets:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_64_char_hex_secret
JWT_SECRET_KEY=CHANGE_ME_generate_another_64_char_hex_secret

# ── JWT Expiry ────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=groupon
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=groupon_power

# Full connection URL (auto-built in docker-compose from above, override here if needed)
# DATABASE_URL=postgresql://groupon:password@postgres:5432/groupon_power

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── File Storage ──────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads

# ── Payment Gateway (Sandbox = safe test mode, Live = real bank) ──────────────
# Set PAYMENT_MODE=sandbox for development (no real money moves)
# Set PAYMENT_MODE=live   for production (requires real credentials below)
PAYMENT_MODE=sandbox

# Razorpay / Bank Payout credentials (only used when PAYMENT_MODE=live)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Single-payment limit in INR (admin configurable guard)
SINGLE_PAYOUT_LIMIT=500000
